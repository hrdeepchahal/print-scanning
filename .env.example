# =============================================================
#  EduBlock Pro — Scanning Service  (.env.example)
#  Copy to .env and fill in real values for this machine.
#  Port: 4545 (fixed — do not change)
# =============================================================


# -------------------------------------------------------------
# SERVER
# -------------------------------------------------------------

# Express server port. Must always be 4545.
PORT=4545

# Log verbosity: error | warn | info | http | debug
# Use "debug" while troubleshooting, "info" in production.
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API via CORS.
# Without this, no cross-origin request is allowed except the dev default below.
# Default (dev): http://localhost:3004  →  exam-ops frontend
ALLOWED_ORIGINS=http://localhost:3004


# -------------------------------------------------------------
# OUTPUT — where scanned PDFs are saved
# -------------------------------------------------------------

# Absolute or relative path to the scans output folder.
# Folder is created automatically if it does not exist.
# Default (relative): ./scans  →  scaning-nodejs/scans/
#
# To save outside the project, use an absolute path:
#   SCANS_DIR=/home/user/Documents/ExamScans
SCANS_DIR=./scans


# -------------------------------------------------------------
# PRINTING — silent print via Puppeteer + CUPS/pdf-to-printer
# -------------------------------------------------------------

# Default printer name for the print API.
# If blank, the system default printer is used.
# Find printer names:  lpstat -p  (Linux/macOS)  or  GET /api/printers
PRINTER_NAME=Your_Printer_Name_Here


# -------------------------------------------------------------
# SCAN BEHAVIOUR
# -------------------------------------------------------------

# Maximum milliseconds to wait for the scanner command.
# 60 000 = 60 seconds (default). Increase for slow/network scanners.
# Example for network scanner: SCAN_TIMEOUT_MS=120000
SCAN_TIMEOUT_MS=60000

# JPEG quality used when embedding the scanned image inside the PDF.
# Range: 1 (smallest file) to 100 (lossless).
# Default: 82  →  ~0.8–1.5 MB per page (vs 11–14 MB with default ZIP)
# Recommended ranges:
#   90–95  →  near-lossless, ~2–4 MB   (archive / legal copy)
#   80–85  →  excellent,     ~0.8–1.5 MB  ✓ exam answer sheets
#   65–75  →  good,          ~400–700 KB  (bulk storage, fast upload)
SCAN_QUALITY=82


# -------------------------------------------------------------
# LINUX / macOS — SANE scanner device settings
# (used on both Linux and macOS)
# -------------------------------------------------------------

# Scan area size in millimeters, sent to scanimage as -l 0 -t 0 -x <W> -y <H>.
# Without this, the ADF source on this eSCL/airscan scanner defaults to its
# MAXIMUM feed length (close to Legal, ~356mm) no matter what paper is
# actually loaded — that's why ADF scans had a tall blank strip at the
# bottom of the page while Flatbed scans looked fine.
# Default: 210 x 297 (A4) — matches the OMR answer sheets.
# Set both to "" to disable and fall back to the device's default scan area.
SCAN_PAGE_WIDTH_MM=210
SCAN_PAGE_HEIGHT_MM=297

# SANE device name for the scanner.
# If set, auto-detection is skipped and this device is used directly.
# If left blank, the service runs  scanimage -L  on every scan and
# auto-selects the first pixma/Canon device (skipping webcams).
#
# Find your device name:  scanimage -L
SANE_DEVICE=

# How long (ms) to cache the scanimage -L device list. That command can take
# several seconds on a network scanner, so it is only re-run when a scan
# fails to open the device. Default: 300000 (5 minutes).
SANE_DEVICE_CACHE_MS=300000

# Scan colour mode passed to scanimage.
# Gray   = smaller file, faster — best for exam answer sheets  ✓
# Color  = full colour scan
# Lineart= black & white line art (smallest file)
#
# Check supported modes: scanimage --help -d <your device name>
SANE_MODE=Gray

# Set to "true" ONLY if your scanner returns:
#   "scanimage: unrecognized option '--resolution=...'"
SANE_SKIP_RESOLUTION=false

# Milliseconds to wait when EVERY known device returns
# "open of device failed: Invalid argument" — the scanner is still holding the
# previous eSCL session. Default: 10000 (10 seconds).
AIRSCAN_RETRY_DELAY_MS=10000

# Per-page timeout budget for the automatic ADF scan (POST /api/scan/auto).
# The overall timeout is max(SCAN_TIMEOUT_MS, pageCount * ADF_PAGE_TIMEOUT_MS)
# since scanning N pages back-to-back from the feeder takes longer than one page.
# Default: 15000 (15 seconds per page).
ADF_PAGE_TIMEOUT_MS=15000


# -------------------------------------------------------------
# WINDOWS ONLY — NAPS2 CLI path
# (only used when running on Windows)
# -------------------------------------------------------------

# Full path to the NAPS2 command-line executable.
# Only change this if NAPS2 is installed in a non-default location.
# Default install path: C:\Program Files\NAPS2\naps2.console.exe
NAPS2_PATH=C:\Program Files\NAPS2\naps2.console.exe
