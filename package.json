{
  "name": "scaning_nodejs",
  "version": "1.0.0",
  "description": "Cross-platform document scanning service",
  "main": "electron/main.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "electron": "electron .",
    "build:win": "node scripts/stage-chromium.js && electron-builder --win",
    "build:linux": "node scripts/stage-chromium.js && electron-builder --linux",
    "build:mac": "node scripts/stage-chromium.js && electron-builder --mac"
  },
  "keywords": [
    "scanning",
    "sane",
    "naps2",
    "pdf",
    "express"
  ],
  "author": "hrdeepchahal",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "marked": "^17.0.5",
    "morgan": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.7.0",
    "puppeteer": "^24.40.0",
    "sharp": "^0.33.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.4"
  }
}
